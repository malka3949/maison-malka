# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — Project Settings → API (server only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — Project Settings → Database → Connection string (URI, pooling off for migrations)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Public site URL (used for absolute links in admin emails, e.g. approve button)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin: receives admin role on login + new-order email alerts (with Resend configured)
ADMIN_EMAIL=admin@maison-malka.example

# Resend — transactional email (server only, never expose to client)
# Create API key at https://resend.com/api-keys
# Use a verified sender/domain for RESEND_FROM_EMAIL in production
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Maison Malka <onboarding@resend.dev>
# Without a verified domain, Resend only delivers to your account email.
# Set this to that inbox so ALL order emails (customer + admin) go there.
# Remove or leave empty once a custom domain is verified.
RESEND_DEV_TO=your-resend-account@email.com

# Optional — free Gemini (Google AI Studio) for product name HE→EN when local dictionary misses
# Server only; never expose to the client. Leave empty to use dictionary-only translation.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
