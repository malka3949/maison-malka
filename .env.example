# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — Project Settings → API (server only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — Project Settings → Database → Connection string (URI, pooling off for migrations)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Admin bootstrap: only this email receives admin role on first login
ADMIN_EMAIL=admin@maison-malka.example

# Resend — transactional email (server only, never expose to client)
# Create API key at https://resend.com/api-keys
# Use a verified sender/domain for RESEND_FROM_EMAIL in production
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Maison Malka <onboarding@resend.dev>
