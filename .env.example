# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — Project Settings → API (server only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — Project Settings → Database → Connection string (URI, pooling off for migrations)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Public site URL (absolute links in emails, e.g. admin approve button)
# Local: http://localhost:3000
# Production: https://your-domain.com  (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin: first-admin bootstrap when DB has no admin yet + new-order email alerts
ADMIN_EMAIL=admin@maison-malka.example

# Resend — transactional email (server only, never expose to client)
# Create API key at https://resend.com/api-keys
# Production: use a verified sender/domain for RESEND_FROM_EMAIL
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Maison Malka <onboarding@resend.dev>
# Without a verified domain, Resend only delivers to your account email.
# Set this in local/dev so order emails land in your inbox (subject shows original To).
# Production: leave empty / unset so customers and ADMIN_EMAIL receive mail directly.
RESEND_DEV_TO=your-resend-account@email.com

# Optional — free Gemini (Google AI Studio) for product name HE→EN when local dictionary misses
# Server only; never expose to the client. Leave empty to use dictionary-only translation.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
